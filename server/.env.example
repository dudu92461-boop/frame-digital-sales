# Banco de dados PostgreSQL.
# Local: use a "connection string" de um banco Neon (neon.tech) ou de um
# PostgreSQL na sua maquina. Producao: definida no painel do Render.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Chave de assinatura da sessao. Em producao, use uma chave longa e aleatoria
# (o Render gera sozinho). Nunca reutilize o valor de exemplo.
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"

PORT=4000
NODE_ENV=development

# Origem do frontend em desenvolvimento (Vite). Em producao o proprio servidor
# entrega o site, entao esta variavel nao e usada.
WEB_ORIGIN="http://localhost:5173"

# Administrador criado automaticamente num banco vazio (primeiro deploy).
# So e usado quando ainda nao existe nenhum admin.
ADMIN_EMAIL="admin@framedigital.com.br"
ADMIN_PASSWORD="frame@2025"
ADMIN_NAME="Administrador Frame Digital"
